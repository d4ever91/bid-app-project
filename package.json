{
  "name": "ordinal-admin-console-svelte",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "api": "npm --prefix server run dev",
    "api:install": "npm --prefix server install",
    "api:build": "npm --prefix server run build",
    "api:start": "npm --prefix server start",
    "api:typecheck": "npm --prefix server run typecheck",
    "api:seed": "npm --prefix server run seed",
    "api:test": "npm --prefix server test",
    "db:up": "node server/scripts/local-mongo.mjs",
    "db:docker": "docker compose up -d mongo",
    "db:docker:down": "docker compose stop mongo"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
