# Copy to server/.env. Every value is optional in development.

PORT=4000

# Browser origins allowed to call the API directly, comma-separated (cookies included).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Frontend URL, used in invite and password-reset links.
APP_URL=http://localhost:5173

# Required when NODE_ENV=production. In development one is generated and stored in data/db.json.
JWT_SECRET=

# Where the JSON database is written (relative to server/).
DATA_FILE=data/db.json

# Optional: route the assistant to Claude. Without it the API answers from workspace data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
