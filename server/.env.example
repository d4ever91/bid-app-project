# Copy to server/.env. Every value is optional in development.

PORT=4000

# Browser origins allowed to call the API directly, comma-separated (cookies included).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Frontend URL, used in invite and password-reset links.
APP_URL=http://localhost:5173

# Required when NODE_ENV=production. In development one is generated and stored in MongoDB.
JWT_SECRET=

# MongoDB connection string. Local default (docker compose up -d mongo):
MONGODB_URI=mongodb://127.0.0.1:27017/ordinal_bids
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ordinal_bids?retryWrites=true&w=majority

# Seed the demo data automatically when the database is empty (ignored in production).
SEED_ON_START=true

# Optional: route the assistant to Claude. Without it the API answers from workspace data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Encrypts the AI API keys and mailbox app passwords stored in MongoDB (Bid automation).
# Generate with: openssl rand -hex 32. Required in production; changing it means re-entering keys.
SECRETS_KEY=

# Stop the background mailbox checker on this instance (e.g. when running several API servers).
# MAIL_POLLING=false
