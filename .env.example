# Base URL the app calls. Leave as /api in development: Vite proxies it to the API
# below, so requests are same-origin from http://localhost:5173 and CORS never applies.
# For a deployed build on a different domain, set the full URL (e.g. https://api.example.com/api)
# and allow the frontend's origin in the API's CORS config.
VITE_API_URL=/api

# Where the dev server forwards /api. Only used by `npm run dev` / `npm run preview`.
API_PROXY_TARGET=http://localhost:4000
